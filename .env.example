# Основная база приложения
DATABASE_URL=postgresql://sqlquest:password@localhost:5432/sqlquest

# Отдельная песочница для SQL-запросов учеников
SANDBOX_ADMIN_DATABASE_URL=postgresql://postgres:password@localhost:5432/sqlquest_sandbox
SANDBOX_DATABASE_URL=postgresql://sqlquest_player:strong-password@localhost:5432/sqlquest_sandbox
SANDBOX_PLAYER_PASSWORD=replace-with-at-least-24-characters

# Публичный адрес сайта без завершающего слеша
SITE_URL=https://scriptkin.ru

# Яндекс ID OAuth. Секрет должен быть только на сервере, без NEXT_PUBLIC_.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# YooKassa: значения из раздела «Интеграция → Ключи API»
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
# 1 — без НДС. Изменяйте только в соответствии с настройками кассы.
YOOKASSA_VAT_CODE=1

# Почта (если используется форма обратной связи)
RESEND_API_KEY=
EMAIL_FROM=
